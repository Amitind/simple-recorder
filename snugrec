#!/usr/bin/env bash
# snugrec: fit an app window to a video shape (16:9, 9:16, 1:1...) and record it, ready to upload.
# Needs KDE Plasma on X11, ffmpeg, xprop, qdbus, pactl, fzf. MIT license.
set -euo pipefail
VERSION=0.1.0
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/snugrec/config

usage() { cat <<EOF
snugrec $VERSION: fit a window to a video shape and record it.

Usage: snugrec [options] [app] [output-file]
  app          part of a window class or title (chrome, firefox, "My Doc").
               Leave out to pick from a list.
  output-file  default: OUT_DIR/<app>-<preset>-<date-time>.<CONTAINER>

Options:
  -p NAME   preset (see config). Leave out to pick from a list.
  -a MODE   audio: mic | sys | both | none
  -f FPS    frames per second
  -r        resize the window only, do not record
  -e        open the config file in \$EDITOR
  -h        this help

Press q to stop recording. Config: $CONF
EOF
}

default_config() { cat <<'EOF'
# snugrec config (bash syntax). Delete this file to get the defaults back.

# Presets: "name|window|output"
#   window: a ratio like 16:9 (largest window of that shape that fits the screen)
#           or an exact size like 1920x1080
#   output: video size in the file. The window is scaled to it.
PRESETS=(
  "youtube|16:9|1920x1080"
  "youtube-4k|16:9|3840x2160"
  "youtube-720p|16:9|1280x720"
  "shorts|9:16|1080x1920"        # YouTube Shorts, Instagram Reels, TikTok
  "square|1:1|1080x1080"         # Instagram, X posts
  "classic|4:3|1440x1080"
  "exact-1080p|1920x1080|1920x1080"  # no scaling; needs space (auto-hide panels)
)
DEFAULT_PRESET=youtube
ASK_PRESET=yes        # yes: show the preset list each run (Enter picks the default)

FPS=60
AUDIO=mic             # mic | sys (what you hear) | both | none
ENCODER=libx264       # libx264 (CPU) | h264_nvenc (NVIDIA GPU, less CPU)
QUALITY=18            # lower is better and bigger (CRF for libx264, CQ for nvenc)
SPEED=veryfast        # libx264 preset: ultrafast ... veryslow
AUDIO_BITRATE=192k
SHOW_CURSOR=1         # 1 records the mouse pointer, 0 hides it

OUT_DIR=~/Videos
CONTAINER=mkv         # mkv survives a crash; mp4 if your editor needs it

NO_BORDER=yes         # hide the title bar so only the app is recorded
KEEP_ABOVE=yes        # keep the window on top while recording
RESTORE_AFTER=yes     # give the border back and stop keeping on top when done
EOF
}

die() { echo "snugrec: $*" >&2; exit 1; }

if [ ! -f "$CONF" ]; then
  mkdir -p "$(dirname "$CONF")"; default_config > "$CONF"
  echo "Created config with defaults: $CONF"
fi
# shellcheck source=/dev/null
source "$CONF"

while getopts "p:a:f:rehv" o; do case $o in
  p) PRESET=$OPTARG ;; a) AUDIO=$OPTARG ;; f) FPS=$OPTARG ;; r) RESIZE_ONLY=1 ;;
  e) exec "${EDITOR:-nano}" "$CONF" ;; v) echo "$VERSION"; exit 0 ;;
  h) usage; exit 0 ;; *) usage >&2; exit 1 ;;
esac; done; shift $((OPTIND - 1))

[ "${XDG_SESSION_TYPE:-x11}" = x11 ] || die "needs an X11 session (this is $XDG_SESSION_TYPE)"
QDBUS=$(command -v qdbus-qt6 || command -v qdbus6 || command -v qdbus) || die "qdbus not found"
for c in ffmpeg xprop fzf pactl; do command -v $c >/dev/null || die "$c not found, please install it"; done

# Pick the window: "0xID  class | title"
list=$(for w in $(xprop -root _NET_CLIENT_LIST | grep -o '0x[0-9a-f]*'); do
  c=$(xprop -id "$w" WM_CLASS | cut -d'"' -f4)
  [ "$c" = plasmashell ] || echo "$w  $c | $(xprop -id "$w" _NET_WM_NAME | cut -d'"' -f2)"
done)
# app name matches the class first; only if no class matches, the title
[ -n "${1:-}" ] && list=$(grep -i -- "^0x[0-9a-f]*  [^|]*$1[^|]* |" <<<"$list" || grep -iF -- "$1" <<<"$list" || true)
[ -n "$list" ] || die "no window matches '${1:-}'"
if [ "$(wc -l <<<"$list")" -gt 1 ]; then
  list=$(fzf --height=40% --reverse --prompt="Window to record> " <<<"$list") || exit 1
fi
WID=${list%% *}
CLS=$(xprop -id "$WID" WM_CLASS | cut -d'"' -f4)
CAP=$(xprop -id "$WID" _NET_WM_NAME | cut -d'"' -f2)

# Pick the preset (default first, so Enter takes it)
if [ -z "${PRESET:-}" ]; then
  PRESET=$DEFAULT_PRESET
  if [ "$ASK_PRESET" = yes ]; then
    PRESET=$(printf '%s\n' "${PRESETS[@]}" | awk -F'|' -v d="$DEFAULT_PRESET" \
      '{l=sprintf("%-14s window %-10s video %s", $1, $2, $3)} $1==d{print l; next} {r=r l "\n"} END{printf "%s", r}' |
      fzf --height=40% --reverse --prompt="Preset> " | cut -d' ' -f1) || exit 1
  fi
fi
spec=$(printf '%s\n' "${PRESETS[@]}" | grep -m1 "^$PRESET|") || die "no preset '$PRESET' in $CONF"
IFS='|' read -r _ WIN OUTSZ <<<"$spec"
OW=${OUTSZ%x*} OH=${OUTSZ#*x}
case $WIN in
  *:*) fit="const k = Math.floor(Math.min(a.width / ${WIN%:*}, a.height / ${WIN#*:}));
        const W = k * ${WIN%:*}, H = k * ${WIN#*:};" ;;
  *x*) fit="const W = Math.min(${WIN%x*}, a.width), H = Math.min(${WIN#*x}, a.height);" ;;
  *) die "preset '$PRESET': window must look like 16:9 or 1920x1080" ;;
esac
echo "Window: $CLS | $CAP"
echo "Preset: $PRESET (window $WIN, video ${OW}x${OH}, ${FPS}fps, audio $AUDIO)"

# KWin JS has no X11 id, so windows are matched by class + title.
# ponytail: two same-titled windows of one app both match
cap=${CAP//\\/\\\\}; cap=${cap//\"/\\\"}
MATCH="String(w.resourceClass).toLowerCase() == \"${CLS,,}\" && w.caption == \"$cap\""
kwin() {  # run JS body $1 on each window matching $2 (default MATCH); the window is w
  local js; js=$(mktemp --suffix=.js)
  printf 'for (const w of workspace.windowList()) if (%s) { %s }\n' "${2:-$MATCH}" "$1" > "$js"
  "$QDBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript snugrec >/dev/null || true
  local id; id=$("$QDBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$js" snugrec)
  "$QDBUS" org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run
  sleep 0.5
  "$QDBUS" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript snugrec >/dev/null; rm -f "$js"
}

yn() { [ "$1" = yes ] && echo true || echo false; }
kwin "w.minimized = false; w.setMaximize(false, false); w.fullScreen = false;
  w.noBorder = $(yn "$NO_BORDER"); w.keepAbove = $(yn "$KEEP_ABOVE");
  const a = workspace.clientArea(KWin.MaximizeArea, w); $fit
  w.frameGeometry = {x: a.x + Math.floor((a.width - W) / 2), y: a.y + Math.floor((a.height - H) / 2), width: W, height: H};
  workspace.activeWindow = w;"
[ -n "${RESIZE_ONLY:-}" ] && exit 0

[ "$RESTORE_AFTER" = yes ] && trap 'kwin "w.noBorder = false; w.keepAbove = false;" "String(w.resourceClass).toLowerCase() == \"${CLS,,}\""' EXIT  # title may change while recording
app=$(tr 'A-Z. ' 'a-z--' <<<"$CLS")
OUT=${2:-$OUT_DIR/$app-$PRESET-$(date +%F-%H%M%S).$CONTAINER}
mkdir -p "$(dirname "$OUT")"

# thread_queue_size keeps audio from dropping when video encoding stalls
mic=(-f pulse -thread_queue_size 1024 -i default)
sys=(-f pulse -thread_queue_size 1024 -i "$(pactl get-default-sink).monitor")
case $AUDIO in
  mic)  a=("${mic[@]}") af=() ;;
  sys)  a=("${sys[@]}") af=() ;;
  both) a=("${mic[@]}" "${sys[@]}") af=(-filter_complex "[1:a][2:a]amix=inputs=2:normalize=0") ;;
  none) a=() af=() ;;
  *) die "AUDIO must be mic, sys, both or none" ;;
esac
case $ENCODER in
  libx264)    v=(-c:v libx264 -preset "$SPEED" -crf "$QUALITY") ;;
  h264_nvenc) v=(-c:v h264_nvenc -preset p5 -rc vbr -cq "$QUALITY" -b:v 0) ;;
  *) die "ENCODER must be libx264 or h264_nvenc" ;;
esac

echo "Recording to $OUT  (press q to stop)"
ffmpeg -hide_banner -loglevel warning -stats \
  -f x11grab -framerate "$FPS" -draw_mouse "$SHOW_CURSOR" -window_id "$WID" -i "$DISPLAY" "${a[@]}" "${af[@]}" \
  -vf "scale=$OW:$OH:flags=lanczos:force_original_aspect_ratio=decrease,pad=$OW:$OH:(ow-iw)/2:(oh-ih)/2,format=yuv420p" \
  "${v[@]}" -c:a aac -b:a "$AUDIO_BITRATE" "$OUT"
